{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },

    /* CSP para raíz, landing e index */
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://ajax.googleapis.com; img-src 'self' data: blob: https://*; media-src 'self' https://*; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://ajax.googleapis.com; connect-src 'self' https://*; object-src 'none'; base-uri 'self'; frame-ancestors 'self';"
        }
      ]
    },
    {
      "source": "/landing/index.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://ajax.googleapis.com; img-src 'self' data: blob: https://*; media-src 'self' https://*; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://ajax.googleapis.com; connect-src 'self' https://*; object-src 'none'; base-uri 'self'; frame-ancestors 'self';"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://ajax.googleapis.com; img-src 'self' data: blob: https://*; media-src 'self' https://*; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://ajax.googleapis.com; connect-src 'self' https://*; object-src 'none'; base-uri 'self'; frame-ancestors 'self';"
        }
      ]
    },

    /* Tipos y caché de assets */
    {
      "source": "/models/(.*).usdz",
      "headers": [
        { "key": "Content-Type", "value": "model/vnd.usdz+zip" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/models/(.*).glb",
      "headers": [
        { "key": "Content-Type", "value": "model/gltf-binary" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/hdr/(.*).hdr",
      "headers": [
        { "key": "Content-Type", "value": "image/vnd.radiance" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/posters/(.*).webp",
      "headers": [
        { "key": "Content-Type", "value": "image/webp" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/landing/(.*).webp",
      "headers": [
        { "key": "Content-Type", "value": "image/webp" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/audio/(.*).mp3",
      "headers": [
        { "key": "Content-Type", "value": "audio/mpeg" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Accept-Ranges", "value": "bytes" }
      ]
    },
    {
      "source": "/splat/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],

  "rewrites": [
    { "source": "/", "destination": "/landing/index.html" },
    { "source": "/splat/:figure", "destination": "/?type=splat&figure=:figure" },
    { "source": "/glb/:model", "destination": "/?type=glb&model=:model" },

    /* Catch-all solo si NO existe archivo/carpeta física */
    {
      "source": "/:model",
      "destination": "/?type=glb&model=:model",
      "missing": [{ "type": "filesystem" }]
    }
  ]
}
